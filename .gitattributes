# Enforce LF line endings everywhere; checkout-as-LF on Windows/WSL too.
# This prevents CRLF noise when editing on Windows-mounted filesystems via WSL.

* text=auto eol=lf

# Source text — explicit for clarity
*.py    text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.html  text eol=lf
*.txt   text eol=lf
*.sh    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
Dockerfile text eol=lf
.env*   text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# SVG is XML/text but normalize LF anyway
*.svg   text eol=lf

# Binary — never touch
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.tar   binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.mp3   binary
*.mp4   binary
*.mov   binary
