# =============================================================================
# Inventory & Order Management System — environment variables
# Copy this file to `.env` and adjust values for your environment.
# DO NOT commit `.env` — it is gitignored by design.
# =============================================================================

# ---- PostgreSQL ----
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=inventory_db
POSTGRES_PORT=5432

# ---- Backend (FastAPI) ----
# In docker-compose this is overridden internally to use service host `db`.
# Set this only if running backend outside compose (e.g. `uvicorn` on host).
DATABASE_URL=postgresql+psycopg://inventory:change_me_in_real_env@localhost:5432/inventory_db
BACKEND_PORT=8000

# Comma-separated list of allowed origins for CORS.
# Add your deployed frontend origin here when going to production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional regex for additional allowed origins (e.g. ephemeral preview URLs).
# Leave empty by default. If you use Vercel previews, set this to a regex
# that matches your project's preview URLs only — never use `.*\\.vercel\\.app$`
# which would allow ANY Vercel project to call your API.
# Example: ^https://your-project(-[a-z0-9-]+)?\\.vercel\\.app$
CORS_ORIGIN_REGEX=

# Expose /docs, /redoc, /openapi.json? Defaults to false (off). Set to `true`
# only after confirming your CSP allows the Swagger UI assets from cdn.jsdelivr.net,
# OR keep this off in production and use the spec offline.
DOCS_ENABLED=false

# Low-stock threshold used by the dashboard endpoint.
LOW_STOCK_THRESHOLD=10

# ---- Frontend (React + Vite) ----
# Base URL the browser should hit for the API.
# In local docker-compose, point the browser at http://localhost:8000.
# In production, set this to your deployed backend URL (e.g. https://api.example.com).
# This is a BUILD-TIME variable — Vite bakes it into the bundle; rebuild after change.
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=3000
